{
    "name": "siresto/siresto-app",
    "type": "project",
    "description": "Sistem Informasi Management Restaurant - Laravel 11",
    "keywords": ["laravel", "framework", "siresto", "restaurant"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
